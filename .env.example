# Discord bot token (keep secret, do not commit real token)
DISCORD_TOKEN=your-bot-token

# Discord application ID and default guild for faster command registration
DISCORD_APP_ID=your-app-id
DISCORD_GUILD_ID=your-guild-id

# Paths to scanners (override if not in PATH)
MASSCAN_BIN=masscan
NMAP_BIN=nmap

# Access control (comma-separated, leave empty for open access)
# Users with ANY of these role IDs OR user IDs can run scans.
ALLOWED_ROLE_IDS=
ALLOWED_USER_IDS=

# Concurrency limits
MAX_CONCURRENT_SCANS=3
MAX_CONCURRENT_PER_USER=1

# Target allowlist (comma-separated CIDRs/IPs, leave empty for unrestricted)
# Example: ALLOWED_TARGETS=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12
ALLOWED_TARGETS=

# Web UI credentials (optional — leave empty to disable web server)
UI_USERNAME=
UI_PASSWORD_HASH=
WEB_PORT=3000
