# Discord bot token (keep secret, do not commit real token)
DISCORD_TOKEN=your-bot-token

# Discord application ID and default guild for faster command registration
DISCORD_APP_ID=your-app-id
DISCORD_GUILD_ID=your-guild-id

# Paths to scanners (override if not in PATH)
MASSCAN_BIN=masscan
NMAP_BIN=nmap
